{
  "name": "@brika/icon-studio",
  "version": "0.1.1",
  "type": "module",
  "description": "Generate square SVG plugin icons from the command line: 200k+ glyphs, gradients, monograms, film grain.",
  "keywords": [
    "icon",
    "icons",
    "svg",
    "cli",
    "icon-generator",
    "gradient",
    "favicon",
    "monogram",
    "lucide",
    "simple-icons",
    "iconify",
    "brika"
  ],
  "license": "MIT",
  "author": "Brika Labs",
  "homepage": "https://icon.brika.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brikalabs/icon-studio.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/brikalabs/icon-studio/issues"
  },
  "bin": {
    "brika-icon": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build.ts",
    "prepack": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@brika/icon-studio-core": "workspace:*",
    "typescript": "^6.0.3"
  }
}
