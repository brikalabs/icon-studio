{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "brika-icon-studio",
  "compatibility_date": "2026-06-01",
  "routes": [{ "pattern": "icon.brika.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
